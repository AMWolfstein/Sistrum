# Graphify scope (allowlist). Graph = source code of every source set:
#   androidApp/src/<set>/ and sharedLogic/src/<set>/ (main, test, androidTest, qa, commonMain, commonTest,
#   and any future set such as dev/prod/debug/release/testDev).
# Everything else (docs, specs, scripts, tools, build outputs, generated code, resources) is excluded.
# gitignore semantics: a path can only be re-included if its parent directory is not excluded.
# Keep in sync with SCOPE/EXCLUDED_PARTS in .claude/hooks/graph_refresh.py.
/*
!/androidApp/
/androidApp/*
!/androidApp/src/
!/sharedLogic/
/sharedLogic/*
!/sharedLogic/src/

# Not source code: resources, prebuilt native libraries, generated/build outputs.
/androidApp/src/*/res/
/androidApp/src/*/jniLibs/
/androidApp/src/*/resources/
/androidApp/src/*/assets/
/androidApp/src/*/cpp/third_party/
/sharedLogic/src/*/resources/
composeResources/
build/
generated/
.cxx/
