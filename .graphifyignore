# Graphify scope (allowlist). Graph = app + test source code only:
#   androidApp/src/{main,test,androidTest}, sharedLogic/src/**.
# Everything else (docs, specs, scripts, tools, build outputs, generated code, resources) is excluded.
# gitignore semantics: a path can only be re-included if its parent directory is not excluded.
/*
!/androidApp/
/androidApp/*
!/androidApp/src/
/androidApp/src/*
!/androidApp/src/main/
!/androidApp/src/test/
!/androidApp/src/androidTest/
!/sharedLogic/
/sharedLogic/*
!/sharedLogic/src/

# Not source code: resources, prebuilt native libraries, generated/build outputs.
/androidApp/src/main/res/
/androidApp/src/main/jniLibs/
/androidApp/src/*/resources/
/androidApp/src/*/assets/
/androidApp/src/main/cpp/third_party/
build/
generated/
.cxx/
