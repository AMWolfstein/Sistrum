package com.amwolfstein.sistrum.player.media3

import kotlin.math.abs
import org.junit.Assert.assertEquals
import org.junit.Assert.assertTrue
import org.junit.Test

class PositionSmootherTest {

    private val maxExtrapolationMs = 500L
    private val smoother = PositionSmoother(maxExtrapolationMs)

    @Test
    fun rawUpdatedEvery10MsTracksWallTime() {
        smoother.reset(0L, 0L)
        var previous = read(0L, false, 0L)
        for (nowMs in 10L..2_000L step 10L) {
            val position = read(nowMs, true, nowMs)
            assertTrue("position=$position wall=$nowMs", abs(position - nowMs) <= 1L)
            assertTrue(position > previous)
            previous = position
        }
    }

    @Test
    fun rawUpdatedEvery250MsKeeps200MsReadsFresh() {
        smoother.reset(0L, 0L)
        var previousRaw = 0L
        var previous = read(0L, false, 0L)
        for (nowMs in 200L..5_000L step 200L) {
            val rawMs = nowMs / 250L * 250L
            val position = read(rawMs, rawMs != previousRaw, nowMs)
            assertTrue("position=$position previous=$previous", position > previous)
            assertTrue("step=${position - previous}", abs(position - previous - 200L) <= 150L)
            assertTrue("position=$position raw=$rawMs", position - rawMs <= 500L)
            previousRaw = rawMs
            previous = position
        }
    }

    @Test
    fun raw80MsBehindConvergesWithoutStallingOrGoingBackwards() {
        smoother.reset(1_000L, 0L)
        var previous = read(1_000L, false, 200L)
        assertEquals(1_200L, previous)
        val delayedRawMs = 1_320L
        for (nowMs in 400L..2_400L step 200L) {
            val rawMs = delayedRawMs + nowMs - 400L
            val position = read(rawMs, true, nowMs)
            assertTrue(position >= previous)
            assertTrue("step=${position - previous}", position - previous in 50L..350L)
            if (nowMs == 400L) assertEquals(1_400L, position)
            if (nowMs == 2_400L) assertTrue(abs(position - (delayedRawMs + 2_000L)) <= 20L)
            previous = position
        }
    }

    @Test
    fun raw80MsAheadIsAdoptedImmediately() {
        smoother.reset(1_000L, 0L)
        assertEquals(1_200L, read(1_000L, false, 200L))
        assertEquals(1_480L, read(1_480L, true, 400L))
    }

    @Test
    fun noRawUpdateFor2SecondsStopsAtExtrapolationLimit() {
        smoother.reset(1_000L, 0L)
        for (nowMs in 100L..2_000L step 100L) {
            val position = read(1_000L, false, nowMs)
            assertTrue(position <= 1_000L + maxExtrapolationMs)
            assertEquals(1_000L + nowMs.coerceAtMost(maxExtrapolationMs), position)
        }
    }

    @Test
    fun pauseReturnsRawAndSeekResetReturnsTarget() {
        smoother.reset(1_000L, 0L)
        assertEquals(1_200L, read(1_000L, false, 200L))
        assertEquals(1_080L, read(1_080L, true, 300L, playing = false))
        assertEquals(1_080L, read(1_080L, false, 1_000L, playing = false))
        // Paused reads also re-anchor the next playing read.
        assertEquals(1_280L, read(1_080L, false, 1_200L))
        smoother.reset(200L, 1_300L)
        assertEquals(200L, read(200L, false, 1_300L))
    }

    @Test
    fun raw5SecondsBehindIsAdoptedAsDiscontinuity() {
        smoother.reset(10_000L, 0L)
        assertEquals(10_200L, read(10_000L, false, 200L))
        assertEquals(5_400L, read(5_400L, true, 400L))
        assertEquals(5_600L, read(5_400L, false, 600L))
    }

    @Test
    fun positionIsClampedToDuration() {
        smoother.reset(900L, 0L)
        assertEquals(1_000L, read(900L, false, 200L, durationMs = 1_000L))
        assertEquals(1_000L, read(1_200L, true, 400L, durationMs = 1_000L))
        assertEquals(1_000L, read(1_200L, false, 600L, playing = false, durationMs = 1_000L))
        smoother.reset(-100L, 700L)
        assertEquals(0L, read(-100L, false, 700L, durationMs = 1_000L))
        assertEquals(0L, read(0L, true, 800L, durationMs = 0L))
    }

    @Test
    fun speed2AdvancesTwiceWallTimeBetweenRawUpdates() {
        smoother.reset(0L, 0L)
        assertEquals(200L, read(0L, false, 100L, speed = 2.0f))
        assertEquals(400L, read(0L, false, 200L, speed = 2.0f))
        assertEquals(600L, read(600L, true, 300L, speed = 2.0f))
        assertEquals(800L, read(600L, false, 400L, speed = 2.0f))
    }

    private fun read(
        rawMs: Long,
        rawChanged: Boolean,
        nowMs: Long,
        playing: Boolean = true,
        speed: Float = 1.0f,
        durationMs: Long? = null,
    ): Long = smoother.read(rawMs, rawChanged, nowMs, playing, speed, durationMs)
}
