package com.amwolfstein.sistrum.player.media3

import kotlin.math.abs
import kotlin.math.min

/**
 * Advances between rendered-position updates, correcting a small lead at half the playback rate.
 * The engine uses a 500 ms guard: twice the dynamic scheduler's ~250 ms cadence, with bounded stall drift.
 */
internal class PositionSmoother(private val maxExtrapolationMs: Long) {

    private var estimateMs = 0.0
    private var rawTimelineMs = 0.0
    private var rawAtMs = 0L
    private var readAtMs = 0L

    fun reset(positionMs: Long, nowMs: Long) {
        estimateMs = positionMs.toDouble()
        rawTimelineMs = estimateMs
        rawAtMs = nowMs
        readAtMs = nowMs
    }

    fun read(
        rawMs: Long,
        rawChanged: Boolean,
        nowMs: Long,
        playing: Boolean,
        speed: Float,
        durationMs: Long?,
    ): Long {
        if (!playing) {
            reset(rawMs, nowMs)
        } else {
            // Only integrate time inside the last raw update's guard; repeated reads cannot extend it.
            val elapsedMs = (nowMs - rawAtMs).coerceIn(0L, maxExtrapolationMs)
            val previousElapsedMs = (readAtMs - rawAtMs).coerceIn(0L, maxExtrapolationMs)
            val advanceMs = (elapsedMs - previousElapsedMs).coerceAtLeast(0L) * speed.toDouble()
            val leadMs = (estimateMs - rawTimelineMs).coerceAtLeast(0.0)
            estimateMs += advanceMs - min(leadMs, advanceMs * 0.5)
            rawTimelineMs += advanceMs
            readAtMs = nowMs

            if (rawChanged) {
                if (abs(rawMs - estimateMs) > 1_000.0) {
                    // An unannounced seek or item change is allowed to break monotonicity.
                    reset(rawMs, nowMs)
                } else {
                    estimateMs = estimateMs.coerceAtLeast(rawMs.toDouble())
                    rawTimelineMs = rawMs.toDouble()
                    rawAtMs = nowMs
                }
            }
        }
        val positionMs = estimateMs.toLong().coerceAtLeast(0L)
        return if (durationMs != null) positionMs.coerceAtMost(durationMs) else positionMs
    }
}
