  "usbBitPerfect": "Hi-res and bit-perfect audio",
  "usbBitPerfectDescription": "Preserve source precision on compatible outputs. Choose direct USB or AAudio exclusive below; otherwise Android USB output requires Android 14 or later. Applies from the next track, without AutoMix or normalization. System volume may not control direct USB.",
  "usbHardwareVolume": "DAC hardware volume",
  "usbVolumeWarningTitle": "Check your listening volume",
  "usbVolumeWarning": "Direct USB audio can be much louder than normal playback, and phone volume buttons may not control it. Lower your DAC or amplifier volume before starting. When supported, Sistrum sets the DAC to at most −40 dB on connection; this does not guarantee a safe listening level on every amplifier or headphone.",
  "usbVolumeAccept": "I understand",
  "usbVolumeUnavailable": "Playback is paused because this DAC has no verified hardware volume control. Lower the DAC or amplifier volume, then enable fixed-volume output if needed and select the track again.",
  "usbFixedVolume": "Allow fixed-volume USB output",
  "usbFixedVolumeDescription": "For DACs without a volume control accessible to the app. Keep off for USB headsets without their own volume control. Applies from the next track.",
  "usbFixedVolumeWarning": "The app cannot lower the volume on this output. Audio may start at full level, and the phone volume slider will not help. Only continue after lowering the volume on your DAC or external amplifier. Do not enable this for a headset without its own volume control.",
  "dapExclusive": "DAP hi-res (AAudio exclusive)",
  "dapExclusiveDescription": "Use Oboe/AAudio at the track's original rate and precision for FLAC/WAV PCM. Requires Android 8.1 or later and compatible hardware. Exclusive access is checked; unavailable formats use normal playback. DSD requires the direct USB driver. Applies from the next track.",
  "dapExclusiveUnavailable": "AAudio exclusive access is unavailable for this track and current output. Using normal playback. For a USB DAC, try the direct USB driver.",
  "exclusiveOutputWindows": "WASAPI exclusive mode",
  "exclusiveOutputMacos": "Exclusive access (hog mode)",
  "exclusiveOutputLinux": "Direct ALSA output",
  "exclusiveOutputDescriptionWindows": "Bypass the Windows mixer so the output follows each track's sample rate and bit depth. Other apps cannot play sound while Sistrum holds the device. AutoMix and previews are off in this mode. For bit-perfect output, keep the volume at 100% with the equalizer and normalization off.",
  "exclusiveOutputDescriptionMacos": "Hold the output device for Sistrum alone and switch it to each track's sample rate and bit depth, so Core Audio does not resample. Other apps cannot play sound while Sistrum holds the device. AutoMix and previews are off in this mode. For bit-perfect output, keep the volume at 100% with the equalizer and normalization off.",
  "exclusiveOutputDescriptionLinux": "Play straight to an ALSA hardware device, bypassing PipeWire or PulseAudio, so the output follows each track's sample rate and bit depth. The device must be free: the sound server releases an idle card after a few seconds, or set its profile to Off. AutoMix and previews are off in this mode.",
  "exclusiveOutputPending": "Takes the device when a track plays.",
  "exclusiveOutputActive": "Playing in exclusive mode.",
  "exclusiveOutputUnavailableWindows": "The device refused exclusive access, so this track plays through the Windows mixer. Close other apps using the device, or allow exclusive control in the device's Windows sound properties.",
  "exclusiveOutputUnavailableMacos": "Another app holds the output device, so this track plays through the system mixer.",
  "exclusiveOutputUnavailableLinux": "The ALSA device is busy, usually held by the sound server, so this track plays through it. Set the card's profile to Off in the sound settings, or choose another device.",
  "exclusiveOutputDevice": "Output device",
  "exclusiveOutputDeviceFirst": "First sound card",
  "exclusiveOutputNoDevices": "No ALSA playback devices found",
  "usbDirect": "Direct USB driver",
  "usbDirectDescription": "Use exclusive USB audio with Android USB permission. FLAC, WAV, ALAC, DSF/DFF and WavPack DSD stay bit-perfect; AAC, MP3, Opus and Vorbis are decoded by the phone and sent directly. Native DSD requires a recognized compatible DAC. Applies from the next track.",
  "usbDsdOverPcm": "DSD over PCM (DoP)",
  "usbDsdOverPcmDescription": "Enable only if your DAC explicitly supports DoP. Sends DSF/DFF and WavPack DSD inside a PCM carrier when native DSD is unavailable. An incompatible device may play noise; leave off for ordinary USB headsets.",
  "usbDsdUnsupported": "This DSD format or connected DAC is not supported. Playback stopped.",
